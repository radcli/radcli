#
# The symbol version must be updated on every libradcli2 major number
# change.
#
# RADCLI2_PRIVATE holds symbols libradcli.so needs across the library
# split (lib/legacy/*.c calling into lib/dict2.c/dict2-parse.c/
# sendserver.c/avp.c/config.c/tls.c/ip_util.c/log.c/util.c internals, and
# the radcli2_priv_* renamed implementations lib/legacy/compat.c
# wraps under their original rc_* names) -- NOT part of the public,
# documented radcli2.h API and not covered by any ABI-stability promise;
# do not link against these from outside this source tree.

RADCLI2_@LIBMAJOR2@
{
  global:
	radcli_ctx_new;
	radcli_ctx_read_config;
	radcli_ctx_read_dictionary;
	radcli_ctx_read_dictionary_from_buffer;
